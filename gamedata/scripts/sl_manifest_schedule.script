  {path="music\\amb07",volume=1.0,pause_min=10.0,pause_max=30.0,from=21.0,to=24.0},
  {path="music\\amb09",volume=0.5,pause_min=10.0,pause_max=30.0,from=0.0,to=0.0},
 },
 ["l05_bar"]={
