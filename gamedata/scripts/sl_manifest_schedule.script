 },
 ["l08_yantar"]={
  {path="music\\amb22",volume=0.2,pause_min=20.0,pause_max=40.0,from=6.0,to=22.0},
  {path="music\\amb17",volume=0.2,pause_min=20.0,pause_max=40.0,from=22.0,to=6.0},
 },
 ["l10_radar"]={
  {path="manifest\\radar",volume=0.22,pause_min=0.0,pause_max=0.0,from=0.0,to=0.0},
