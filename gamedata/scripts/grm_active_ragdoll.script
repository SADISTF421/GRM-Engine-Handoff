-- Короткое движение тела после смерти; без урона и дополнительных ударов.
local DURATION = 4800
local START_DELAY = 250
local SHELL_WAIT = 1500
local CHANCE = 55

function on_death(binder, who, head_hit, head_window)
    binder.grm_active_ragdoll = nil
    local npc = binder.object
    if not npc then return end
    local now = time_global()
    if who then
        local ok, self_hit = pcall(function() return who:id() == npc:id() end)
        if ok and self_hit then return end
    end
    local headshot = false
    if head_hit and head_hit.time and now >= head_hit.time and now - head_hit.time <= (head_window or 1200) then
        headshot = true
        if who and head_hit.who_id then
            local ok, killer_id = pcall(function() return who:id() end)
            if ok and tonumber(killer_id) ~= tonumber(head_hit.who_id) then headshot = false end
        end
    end
    if not headshot and math.random(1, 100) > CHANCE then return end
    binder.grm_active_ragdoll = { start = now, last = now, seed = math.random(1, 999), headshot = headshot }
end

function clear(binder)
    binder.grm_active_ragdoll = nil
end

local function push(shell, name, x, y, z)
    pcall(function()
        local element = shell:get_element_by_bone_name(name)
        if element then element:apply_force(x, y, z) end
    end)
end

function update(binder)
    local s = binder.grm_active_ragdoll
    if not s then return end
    local npc = binder.object
    if not npc then clear(binder); return end
    local now = time_global()
    local age = now - s.start
    local duration = s.headshot and 1300 or DURATION
    local delay = s.headshot and 80 or START_DELAY
    if age < 0 or age >= duration then clear(binder); return end
    if age < delay then s.last = now; return end
    local ok, alive = pcall(function() return npc:alive() end)
    if not ok or alive then clear(binder); return end
    local shell_ok, shell = pcall(function() return npc:get_physics_shell() end)
    if not shell_ok then clear(binder); return end
    if not shell then
        if age >= SHELL_WAIT then clear(binder) end
        s.last = now
        return
    end
    local dt = math.min(math.max((now - s.last) / 1000, 0), 0.05)
    s.last = now
    if dt <= 0 then return end
    -- При попадании в голову только кратко подгибаем ноги, без судорог.
    if s.headshot then
        local hip_ok, hip = pcall(function() return npc:bone_position("bip01_pelvis") end)
        if not hip_ok or not hip then return end
        local fade = math.max(0, (duration - age) / duration)
        local ramp = math.min(1, math.max(0, (age - delay) / 200))
        local names = {"bip01_l_calf", "bip01_r_calf", "bip01_l_foot", "bip01_r_foot"}
        for i, name in ipairs(names) do
            local pos_ok, pos = pcall(function() return npc:bone_position(name) end)
            if pos_ok and pos then
                local dx, dy, dz = hip.x - pos.x, hip.y - pos.y, hip.z - pos.z
                local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
                if dist > 0.08 then
                    local scale = (i <= 2) and 0.75 or 1
                    local f = 4200 * dt * fade * ramp * scale * math.min(dist, 1)
                    push(shell, name, dx / dist * f, dy / dist * f, dz / dist * f)
                end
            end
        end
        return
    end
    local fade = math.max(0, (DURATION - age) / DURATION)
    local ramp = math.min(1, math.max(0, (age - START_DELAY) / 450))
    fade = fade * fade * (3 - 2 * fade) * ramp
    local phase = age * 0.0025 + (s.seed % 7) * 0.17
    -- Плавные движения ног направлены к тазу, а не в сторону по карте.
    local hip_ok, hip = pcall(function() return npc:bone_position("bip01_pelvis") end)
    if hip_ok and hip then
        local leg_names = {"bip01_l_calf", "bip01_r_calf", "bip01_l_foot", "bip01_r_foot"}
        for i, name in ipairs(leg_names) do
            local pos_ok, pos = pcall(function() return npc:bone_position(name) end)
            if pos_ok and pos then
                local dx, dy, dz = hip.x - pos.x, hip.y - pos.y, hip.z - pos.z
                local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
                if dist > 0.08 then
                    local side = (i % 2 == 0) and 1.3 or 0
                    local pulse = (1 + math.sin(phase + side)) * 0.5
                    pulse = pulse * pulse
                    local scale = (i <= 2) and 0.75 or 1.0
                    local f = 5500 * dt * fade * pulse * scale * math.min(dist, 1)
                    push(shell, name, dx / dist * f, dy / dist * f, dz / dist * f)
                end
            end
        end
    end
    -- Слабо тянем руки к груди, только если позиции костей доступны.
    local target_ok, chest = pcall(function() return npc:bone_position("bip01_spine2") end)
    if not target_ok or not chest then return end
    for _, name in ipairs({"bip01_l_hand", "bip01_r_hand"}) do
        local bone_ok, pos = pcall(function() return npc:bone_position(name) end)
        if bone_ok and pos then
            local dx, dy, dz = chest.x - pos.x, chest.y - pos.y, chest.z - pos.z
            local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
            if dist > 0.05 then
                local pulse = 0.5 + 0.5 * math.sin(phase * 0.75)
                local f = 1800 * dt * fade * pulse * math.min(dist, 1)
                push(shell, name, dx / dist * f, dy / dist * f, dz / dist * f)
            end
        end
    end
end
