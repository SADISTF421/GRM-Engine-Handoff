// Diagnostic alpha coverage for 2x multiplicative wallmark blending.
// Transparent pixels become neutral gray instead of darkening cloth.
// Requires shader model 2.0. Opaque/missing texture alpha cannot be repaired here.
uniform sampler2D s_base;
struct pin { float4 color : COLOR0; float2 uv : TEXCOORD0; };
float4 main(pin I) : COLOR
{
    float edge = min(min(I.uv.x, I.uv.y), min(1.0-I.uv.x, 1.0-I.uv.y));
    clip(edge);
    float4 C = tex2D(s_base, I.uv);
    clip(C.a - (0.5/255.0));
    float coverage = saturate(C.a) * saturate(edge * 32.0);
    coverage *= 1.0 - saturate(I.color.a);
    C.rgb = lerp(float3(0.5, 0.5, 0.5), C.rgb, coverage);
    return float4(C.rgb, 1.0);
}
