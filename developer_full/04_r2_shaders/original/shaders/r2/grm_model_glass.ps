#include "common.h"

struct v2p
{
    float2 tc0 : TEXCOORD0;
    half3 tc1 : TEXCOORD1;
    half grm_fresnel : TEXCOORD2;
    half4 c0 : COLOR0;
};

uniform samplerCUBE s_env;
half4 main(v2p I) : COLOR
{
    half4 tex = tex2D(s_base, I.tc0);
    half3 env = texCUBE(s_env, I.tc1).rgb;
    half3 base = lerp(env, tex.rgb, tex.a);
    // Не меняем прозрачность и используем уже подключённое отражение неба.
    base = lerp(base, env, saturate(I.grm_fresnel) * 0.12h);
    half3 final = I.c0.rgb * base * 2.0h;
    return half4(final, tex.a * I.c0.a);
}
