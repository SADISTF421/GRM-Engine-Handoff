  {path="music\\07_mutation",volume=0.5,pause_min=10.0,pause_max=30.0,from=0.0,to=0.0},
  {path="music\\amb03",volume=0.5,pause_min=10.0,pause_max=30.0,from=0.0,to=0.0},
 },
 ["l07_military"]={
  {path="manifest\\arm_skladi",volume=0.22,pause_min=0.0,pause_max=0.0,from=0.0,to=0.0},
  {path="manifest\\manifest_ambient",volume=0.16,pause_min=0.0,pause_max=0.0,from=0.0,to=0.0},
  {path="manifest\\narastanie_manifest",volume=0.14,pause_min=0.0,pause_max=0.0,from=0.0,to=0.0},
