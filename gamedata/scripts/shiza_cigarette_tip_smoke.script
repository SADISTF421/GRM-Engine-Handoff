local function vec(x,y,z) return vector():set(x,y,z) end
local function stop_emitter(s)
    if s and s.ps then pcall(function() s.ps:stop() end); s.ps=nil end
end
function finish(s)
    if not s then return end
    s.stopped=true
    stop_emitter(s)
    if active==s then active=nil end
end
function reset()
    epoch=epoch+1
    finish(active)
    active=nil
end
function start(now)
    reset()
    local actor=db.actor
    local s={started=now,token=epoch,actor_id=actor and actor:id() or nil}
    active=s
    trace("started_hud_ratio_"..tostring(HUD_FOV_RATIO))
    return s
end
local function sample(elapsed)
    local frame=elapsed*FPS/1000
    if frame<FIRST_FRAME or frame>LAST_FRAME then return nil end
    local i=math.floor(frame)-FIRST_FRAME+1
    local a=path[i]
    local b=path[math.min(i+1,#path)]
    local t=frame-math.floor(frame)
    return a[1]+(b[1]-a[1])*t, a[2]+(b[2]-a[2])*t, a[3]+(b[3]-a[3])*t
end
local function position(elapsed)
    local x,depth,up=sample(elapsed)
    if not x then return nil end
    local d=device()
    if not d or not d.cam_pos or not d.cam_dir or not d.cam_top then return nil end
    local fov=67.5
    local ok,value=pcall(function() return d.fov end)
    if ok and type(value)=="number" and value>20 and value<150 then fov=value end
    local radians=fov*math.pi/180
    local scale=math.tan(radians/2)/math.tan(radians*HUD_FOV_RATIO/2)
    x=x*scale+OFFSET_RIGHT; up=up*scale+OFFSET_UP; depth=depth+OFFSET_FORWARD
    -- Do not emit behind the camera or far outside the view.
    if depth<0.08 then return nil end
    local p,dir,top=d.cam_pos,d.cam_dir,d.cam_top
    local rx=top.y*dir.z-top.z*dir.y
    local ry=top.z*dir.x-top.x*dir.z
    local rz=top.x*dir.y-top.y*dir.x
    return vec(p.x+rx*x+dir.x*depth+top.x*up,
               p.y+ry*x+dir.y*depth+top.y*up,
               p.z+rz*x+dir.z*depth+top.z*up)
end
function update(s,now)
    if not s or s.stopped or s.disabled or s.token~=epoch then return end
    local actor=db.actor
    if not actor or not actor:alive() or actor:id()~=s.actor_id then finish(s);return end
    local elapsed=now-s.started
    if elapsed>LAST_FRAME*1000/FPS then finish(s);return end
    if elapsed<FIRST_FRAME*1000/FPS then return end
    local pos=position(elapsed)
    if not pos then stop_emitter(s);return end
    local ok,err=pcall(function()
        if not s.ps then
            s.ps=particles_object(EFFECT)
            s.ps:move_to(pos,vec(0,0,0))
            s.ps:play_at_pos(pos)
            trace("emitter_created_elapsed_"..tostring(math.floor(elapsed)))
        else
            s.ps:move_to(pos,vec(0,0,0))
        end
    end)
    if not ok then
        stop_emitter(s);s.disabled=true
        trace("failed_"..tostring(err))
        if type(printf)=="function" then printf("[cig_tip_smoke] %s",tostring(err)) end
    end
end
