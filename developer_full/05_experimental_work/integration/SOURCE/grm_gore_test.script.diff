+-- Отменяем только ожидающий запуск эффекта и временную отметку удара.
+-- Живые частицы и состояние скрытой головы не уничтожаем.
+function prepare_harvest(binder)
+    if not binder or not binder.object then return end
+    local ok,id = pcall(function() return binder.object:id() end)
