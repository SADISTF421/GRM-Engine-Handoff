#include "common.h"
#include "sload.h"
#if defined(USE_TDETAIL) && !defined(USE_4_DETAIL)
#define SL_STATIC_WET_TRIAL
#define GRM_PUDDLE_REFLECTION
#define GRM_PUDDLE_RIPPLE
#endif
#include "f42_weather.h"

// TEST6: wetness uses the existing weather channel and sky exposure.

// ShizoMod R2: one detail texture for the terrain, as the original SoC R2 does. The 4-detail
// splat needs a terrain mask (terrain_*_mask) the mod does not have, and without it the
// terrain came out flat ("soap"). The single detail is the one textures.ltx names for it.
//#define	USE_4_DETAIL

#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
#	define	USE_4_BUMP
#endif

#ifdef USE_4_BUMP
f_deffer 	main	( p_bumped I 	)
#else
f_deffer 	main	( p_flat I 		)
#endif
{
	f_deffer	O;

 	// diffuse
	half4 D		= tbase		(I.tcdh);			// IN:  rgb.a
	half4 L 	= tex2D		(s_lmap, I.tcdh);

	half	G	= def_gloss	;

# ifdef	USE_TDETAIL
 # ifdef USE_4_DETAIL
	half4	mask= tex2D		(s_mask, I.tcdh);
	half 	mag	= max		(dot(mask,1), 0.001h);
			mask= mask/mag	;

	half3	d_R	= det_pick(s_dt_r, I.tcdbump)*mask.r;
	half3	d_G	= det_pick(s_dt_g, I.tcdbump)*mask.g;
	half3	d_B	= det_pick(s_dt_b, I.tcdbump)*mask.b;
	half3	d_A	= det_pick(s_dt_a, I.tcdbump)*mask.a;
	half3	dt	= d_R+d_G+d_B+d_A;
		D.rgb	= 2*D.rgb*dt	 ;

  # ifdef USE_4_BUMP

 	 half4	n_Rt = tex2D	(s_dn_r, I.tcdbump).wzyx;
	 half4	n_Gt = tex2D	(s_dn_g, I.tcdbump).wzyx;
	 half4	n_Bt = tex2D	(s_dn_b, I.tcdbump).wzyx;
	 half4	n_At = tex2D	(s_dn_a, I.tcdbump).wzyx;
	 
 	 half3	n_R = (n_Rt-0.5)*mask.r; half g_R=n_Rt.w*mask.r;
	 half3	n_G = (n_Gt-0.5)*mask.g; half g_G=n_Gt.w*mask.g;
	 half3	n_B = (n_Bt-0.5)*mask.b; half g_B=n_Bt.w*mask.b;
	 half3	n_A = (n_At-0.5)*mask.a; half g_A=n_At.w*mask.a;

	 half3	mix		= 	n_R+n_G+n_B+n_A;
			mix.z	*=	0.5;		//. make bump twice as contrast (fake, remove me if possible)
	 half3	N		= 	mul     	(half3x3(I.M1, I.M2, I.M3), mix.xyz);

	 	 	G 		= 	g_R+g_G+g_B+g_A;
//			G 	= 0			;
//			G 	= mix.w		;		// gloss
  # else
	half3	N 	= I.N.xyz	;
  # endif

 # else
    // Сохраняю нейтральную детализацию и слегка усиливаю её контраст.
    half3 grm_detail = det_pick(s_detail, I.tcdbump);
    grm_detail = max(half3(0.h,0.h,0.h), 0.5h + (grm_detail - 0.5h) * 1.08h);
    D.rgb = 2 * D.rgb * grm_detail;
	half3	N 	= I.N.xyz	;	// the single-detail path had no normal of its own
 # endif
# else
	half3	N 	= I.N.xyz	;
# endif

#if defined(USE_TDETAIL) && !defined(USE_4_DETAIL)
    // This implicit-lightmap path writes D.w as its native G-buffer hemi.
    // Use that same exposure channel; do not add a new lightmap sampler here.
    half f42_hemi=D.w;
    half3 grm_ripple_eye;
    half grm_reflection_pool;
    f42_wet_flat_ground(D.rgb, G, (half3)N, I.position.xyz, f42_hemi, grm_reflection_pool, grm_ripple_eye);
    N = normalize(N + grm_ripple_eye);
#endif

	// hemi, sun, material
	half 	ms	= xmaterial	;
# ifdef USE_R2_STATIC_SUN
		 	ms 	= L.w		;
# endif

  // 2. Standart output
  O.Ne          = half4		(normalize(N), 									D.w			);	// hemi
  O.position    = half4 	(I.position.xyz + O.Ne.xyz*def_virtualh/2.h, 	ms			);	//
  O.C			= half4		(D.x,	D.y,	D.z,							G			);	// OUT: rgb.gloss
#if defined(USE_TDETAIL) && !defined(USE_4_DETAIL)
  // Небольшая метка в длине нормали только там, где уже есть лужа.
  O.Ne.xyz *= 1.0h + 0.03h * grm_reflection_pool;
#endif

  return O;
}
