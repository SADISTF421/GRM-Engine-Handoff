 ["l09_deadcity"]={
  {path="music\\amb01",volume=0.5,pause_min=10.0,pause_max=20.0,from=0.0,to=12.0},
  {path="music\\amb03",volume=0.5,pause_min=10.0,pause_max=15.0,from=0.0,to=12.0},
  {path="music\\amb07",volume=1.0,pause_min=5.0,pause_max=25.0,from=12.0,to=24.0},
 },
 ["l23_final_battle"]={
  {path="music\\amb01",volume=0.5,pause_min=10.0,pause_max=20.0,from=0.0,to=12.0},
  {path="music\\amb03",volume=0.5,pause_min=10.0,pause_max=15.0,from=0.0,to=12.0},
  {path="music\\amb07",volume=1.0,pause_min=5.0,pause_max=25.0,from=12.0,to=24.0},
 },
