#include "common.h"
#include "sload.h"
#if defined(USE_TDETAIL) && defined(USE_LM_HEMI)
#define SL_STATIC_WET_TRIAL
#define GRM_PUDDLE_REFLECTION
#endif
#include "f42_weather.h"

f_deffer 	main	( p_flat I )
{
  f_deffer	O;

  // diffuse
  half3 D	= tbase		(I.tcdh);	// IN:  rgb.a

#ifdef	USE_TDETAIL
#ifdef USE_LM_HEMI
    // Уточняю детали только на освещённых статических поверхностях.
    half3 grm_detail = det_pick(s_detail, I.tcdbump);
    grm_detail = max(half3(0.h,0.h,0.h), 0.5h + (grm_detail - 0.5h) * 1.08h);
    D.rgb = 2 * D.rgb * grm_detail;
#else
    D.rgb = 2*D.rgb*det_pick(s_detail, I.tcdbump);
#endif
#endif

	// hemi,sun,material
	half 	ms	= xmaterial		;
#ifdef USE_LM_HEMI
	half4	lm 	= tex2D			(s_hemi, I.lmh);
	half 	h  	= dot			(lm.rgb,1.h/3.h);
# ifdef USE_R2_STATIC_SUN
		 	ms 	= lm.w			;
# endif
#else
	half 	h	= ((I.position.w < -1.5f) ? (-I.position.w - 2.0f) : I.position.w)	;
# ifdef USE_R2_STATIC_SUN
		 	ms	= I.tcdh.w		;
# endif
#endif

  half f42_gloss=def_gloss;
#if defined(USE_TDETAIL) && defined(USE_LM_HEMI)
  half grm_reflection_pool;
  f42_wet_flat_ground(D.rgb, f42_gloss, (half3)I.N.xyz, I.position.xyz, h, grm_reflection_pool);
#endif

  // 2. Standart output
  O.Ne          = half4		(normalize((half3)I.N.xyz), 					h			);
  O.position    = half4 	(I.position.xyz + O.Ne.xyz*def_virtualh/2.h, 	ms			);
  O.C			= half4		(D.rgb,											f42_gloss	);	// OUT: rgb.gloss
#if defined(USE_TDETAIL) && defined(USE_LM_HEMI)
  // Небольшая метка в длине нормали только там, где уже есть лужа.
  O.Ne.xyz *= 1.0h + 0.03h * grm_reflection_pool;
#endif

  // SL_MODEL_SPEC_TEST1: suppress only tagged model G-buffer gloss.
  // RGB, normals, material/sun and restored hemi are unchanged.
  O.C.w *= (I.position.w < -1.5f) ? 0.0h : 1.0h;

  return O;
}
