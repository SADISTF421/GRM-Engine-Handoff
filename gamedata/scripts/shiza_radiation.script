function play_sound()
	if not db.actor then
		return
	end

	local snd_obj = xr_sound.get_safe_sound_object(random_sounds[math.random(#random_sounds)])
	snd_obj:play_at_pos(db.actor, vector():set(0, 0, 0), 0, sound_object.s2d)
end

-- // Юз предмета, вызываемый из bind_stalker.script
function on_actor_use(obj, section)
    restore_pending()
    update_item_timers()
	if not db.actor or not db.actor:alive() then
		return
	end
	
	if not obj and not section then
		return 
	end
	
	if section and section ~= "antirad" then
		return
	end
	

	if obj and obj:section() ~= "antirad" then
		return
	end

	if _is_suicided or shiza_vodka.is_death_started() then return end

	counter = counter + 1

	if counter >= 4 then
		do_antirad_overdose_death()
		return

	elseif counter >= 3 then
		if panic_sound and panic_sound:playing() then
			panic_sound:stop()
		end

		panic_sound = xr_sound.get_safe_sound_object("affects\\panichka")

		if panic_sound then
			panic_sound:play_at_pos(db.actor, vector():set(0, 0, 0), 0, sound_object.s2d)
		end

		play_sound()

		if not antirad_ppe_enabled then
			antirad_ppe_enabled = true
			level.add_pp_effector("dead_zone2.ppe", 6768, true)
			level.set_pp_effector_factor(6768, 0.85)
			level.add_pp_effector("alcohol.ppe", 6671, true)
			level.set_pp_effector_factor(6671, 0.4)
			level.add_cam_effector("camera_effects\\scope_shake.anm", 6769, false, "")
		end
	end

    -- Каждая завершённая доза продлевает прежний общий срок сброса.
    antirad_reset_time=time_global()+ANTIRAD_USE_TIMER

end

function is_death_started() return _is_suicided end

function reset()
    terminal_kind,terminal_until,kick_at,fall_at=0,0,-1,-1
    pending_state=nil
    if antirad_scene_sound and antirad_scene_sound:playing() then antirad_scene_sound:stop() end
    antirad_scene_sound=nil
    session_generation = session_generation + 1
    if _is_suicided then level.enable_input() end
    _is_suicided = false
    suicide_knife_visible = false
    _current_radiation_time = 0
    counter = 0
    antirad_reset_time = 0
    antirad_reset_scheduled = false
    meat_shiza = 0
    meat_decay_after = 0
    meat_last_update = nil
    radiation_ppe_enabled = false
    antirad_ppe_enabled = false
    phantom_idle = nil
    phantom_time = 0
    if panic_sound and panic_sound:playing() then panic_sound:stop() end
    panic_sound = nil
    if suicide_scene_sound and suicide_scene_sound:playing() then suicide_scene_sound:stop() end
    suicide_scene_sound = nil
    for _, id in ipairs({6767, 6768, 6671}) do level.remove_pp_effector(id) end
    for _, id in ipairs({6769, 6801, 1900, 1901, 1902, 1903, 1904}) do level.remove_cam_effector(id) end
end

function should_hide_weapon() return _is_suicided and not suicide_knife_visible end


function save_state(actor)
    if pending_state then
        shiza_state.write(actor,"radiation",pending_state)
        return
    end
    update_meat_shiza()
    local now=time_global()
    shiza_state.write(actor,"radiation",{count=counter,
        reset=shiza_state.left(antirad_reset_time,now),meat=meat_shiza,
        meat_delay=shiza_state.left(meat_decay_after,now),danger=_current_radiation_time,
        terminal=terminal_kind,finish=shiza_state.left(terminal_until,now),
        kick=kick_at>=0 and shiza_state.left(kick_at,now) or -1,
        fall=fall_at>=0 and shiza_state.left(fall_at,now) or -1})
end
function queue_load_state(actor)
    pending_state=shiza_state.read(actor,"radiation")
end
function restore_pending()
    if not pending_state or not db.actor or not db.actor:alive() then return end
    local saved=pending_state
    reset()
    local now=time_global()
    counter=math.floor(shiza_state.number(saved,"count",0,0,4))
    local left=shiza_state.number(saved,"reset",0,0,ANTIRAD_USE_TIMER)
    antirad_reset_time=now+left
    meat_shiza=shiza_state.number(saved,"meat",0,0,1)
    meat_decay_after=now+shiza_state.number(saved,"meat_delay",0,0,MEAT_SHIZA_DECAY_DELAY)
    meat_last_update=now
    _current_radiation_time=shiza_state.number(saved,"danger",0,0,SUICIDE_TIMER)
    local kind=math.floor(shiza_state.number(saved,"terminal",0,0,3))
    local finish=shiza_state.number(saved,"finish",0,0,60000)
    if kind==0 and left<=0 then counter=0 end
    if counter>=3 then
        antirad_ppe_enabled=true
        level.add_pp_effector("dead_zone2.ppe",6768,true);level.set_pp_effector_factor(6768,0.85)
        level.add_pp_effector("alcohol.ppe",6671,true);level.set_pp_effector_factor(6671,0.4)
        if kind==0 then
            panic_sound=xr_sound.get_safe_sound_object("affects\\panichka")
            if panic_sound then panic_sound:play_at_pos(db.actor,VECTOR_ZERO,0,sound_object.s2d) end
        end
    end
    if kind==1 then
        do_suicide(finish)
    elseif kind==2 or kind==3 then
        _is_suicided=true;terminal_kind=kind;terminal_until=now+finish
        level.disable_input()
        suicide_knife_visible=kind==2 and db.actor:object(ANIM_SUICIDE_KNIFE)~=nil
        if suicide_knife_visible then db.actor:restore_weapon() else db.actor:hide_weapon() end
        local kr=shiza_state.number(saved,"kick",-1,-1,60000)
        local fr=shiza_state.number(saved,"fall",-1,-1,60000)
        kick_at=kr>=0 and now+kr or -1
        fall_at=fr>=0 and now+fr or -1
        -- Уже прошедшие анимации не повторяются и срок смерти не продлевается.
    end
end
