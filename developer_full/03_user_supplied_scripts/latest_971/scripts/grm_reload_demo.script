-- Requires the patched engine exposing weapon:grm_is_reloading().
-- This is a state-driven prototype; it does not bind any key or change player name.
local last_id,last_section,last_reload,active_id,until_at=nil,nil,false,nil,nil
local disabled=false
local function stop()
    if active_id then pcall(function() level.remove_cam_effector(ID) end) end
    active_id,until_at=nil,nil
end
function reset()
    stop();last_id,last_section,last_reload=nil,nil,false;disabled=false
end
local function allowed(a)
    if not a or not a:alive() or a:is_talking() or a.health<=0.20 then return false end
    if device().precache_frame>0 or a:has_info("disabled_ui") then return false end
    if shiza_hud_items and shiza_hud_items.is_using_item and shiza_hud_items.is_using_item() then return false end
    if shiza_kill_stress and shiza_kill_stress.is_active and shiza_kill_stress.is_active() then return false end
    if shiza_radiation and shiza_radiation.is_death_started and shiza_radiation.is_death_started() then return false end
    if shiza_vodka and shiza_vodka.is_death_started and shiza_vodka.is_death_started() then return false end
    return true
end
local function step(a)
    if disabled then return end
    if not allowed(a) then stop();last_id,last_section,last_reload=nil,nil,false;return end
    local w=a:active_item()
    if not w then stop();last_id,last_section,last_reload=nil,nil,false;return end
    local sec,id=w:section(),w:id()
    local entry=FILES[sec]
    if not entry then stop();last_id,last_section,last_reload=nil,nil,false;return end
    local ok,reloading=pcall(function() return w:grm_is_reloading() end)
    if not ok or type(reloading)~="boolean" then
        stop();disabled=true;printf("[grm_reload_demo] Engine method grm_is_reloading missing; disabled")
        return
    end
    if id~=last_id or sec~=last_section then stop();last_reload=false end
    local now=time_global()
    if active_id and (not reloading or now>=until_at) then stop() end
    if reloading and not last_reload then
        stop()
        local d=level.add_cam_effector(entry[1],ID,false,"")
        if type(d)~="number" or d<0.1 or d>20 then d=entry[2] end
        active_id=id;until_at=now+math.ceil(d*1000)
    end
    last_id,last_section,last_reload=id,sec,reloading
end
function update(a)
    local ok,err=pcall(step,a)
    if not ok then stop();disabled=true;printf("[grm_reload_demo] disabled: %s",tostring(err)) end
end
